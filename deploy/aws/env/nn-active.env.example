# dfsha-nn-active  IP privada 172.31.0.10
# Copiar a /opt/dfsha/node.env (no se sube al repo).
NODE_ID=nn1
NAMENODE_ROLE=active
REST_PORT=8080
GRPC_PORT=9000
ADVERTISE_ADDR=172.31.0.10:9000
PEER_NAMENODE_ADDR=172.31.0.11:9000
NAMENODE_ADDRS=172.31.0.10:9000,172.31.0.11:9000
BLOCK_SIZE_MB=8
REPLICATION_FACTOR=3
DATA_DIR=/data
TLS_ENABLED=false
JWT_SECRET=cambia-esto-igual-en-los-dos-namenodes
# Replicacion al standby. Con el standby apagado (Hito 2) usa false: el activo sigue sirviendo y le
# reenvia lo pendiente cuando el standby vuelva. Con el standby encendido (Hito 3) usa true: el activo
# no confirma ninguna escritura hasta que el standby la aplique, asi no se pierde nada si el activo cae.
HA_REQUIRE_ACK=false
